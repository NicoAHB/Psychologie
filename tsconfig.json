{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "resolveJsonModule": true, "allowImportingTsExtensions": true,
    "noEmit": true, "strict": true, "noUnusedLocals": true, "noUnusedParameters": true, "noFallthroughCasesInSwitch": true, "skipLibCheck": true,
    "esModuleInterop": true, "types": ["vite/client", "node"]
  },
  "include": ["src", "vite.config.ts", "tests", "playwright.config.ts"]
}
