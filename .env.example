# Public project settings; never put a service-role key or Telegram token in VITE_*.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# PEM public key, with literal \n between lines; private key stays with reminder worker.
VITE_REMINDER_PUBLIC_KEY=
# Enable only after deploying/configuring the authenticated email function. No email provider secret here.
VITE_EMAIL_ENABLED=false
# Enable only after configuring the authenticated PDF delivery function. Bot token stays on the server.
VITE_TELEGRAM_ENABLED=false

# Optional own/trusted STUN endpoints (comma-separated); never TURN. No default third-party server.
# Using these is a separate opt-in in the call UI; STUN sees IP addresses, never media.
VITE_WEBRTC_STUN_URLS=
