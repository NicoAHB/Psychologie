# Public project settings; never put a service-role key or Telegram token in VITE_*.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# PEM public key, with literal \n between lines; private key stays with reminder worker.
VITE_REMINDER_PUBLIC_KEY=
# Enable only after deploying/configuring the authenticated email function. No email provider secret here.
VITE_EMAIL_ENABLED=false
